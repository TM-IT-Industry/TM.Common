<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet Package Metadata -->
		<PackageId>TM.Common.Constants</PackageId>
		<Version>1.0.1</Version>
		<VersionSuffix>alpha</VersionSuffix>
		<Title>TM Common.Constants</Title>
		<Description>A collection of common constants and static details for TM applications</Description>
		<Authors>Kenneth Napura</Authors>
		<PackageProjectUrl>https://github.com/kenjie-sama/TM.Common/tree/master/TM.Common.Utils</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kenjie-sama/TM.Common</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

</Project>
