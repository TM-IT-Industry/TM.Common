<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet Package Metadata -->
		<PackageId>TM.Common.Utils</PackageId>
		<Version>1.0.10</Version>
		<VersionSuffix>alpha</VersionSuffix>
		<Title>TM Common.Utils</Title>
		<Description>A collection of common utilities for TM applications</Description>
		<Authors>Kenneth Napura</Authors>
		<PackageProjectUrl>https://github.com/kenjie-sama/TM.Common/tree/master/TM.Common.Utils</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kenjie-sama/TM.Common</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
	</ItemGroup>

</Project>
