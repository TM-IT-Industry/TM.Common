<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		
		<!-- NuGet Package Metadata -->
		<PackageId>TM.Common.EntityFrameworkCore</PackageId>
		<Version>1.0.1</Version>
		<Title>TM Common.EntityFrameworkCore</Title>
		<Description>A collection of common entity framework core models, methods and base entities for TM applications</Description>
		<Authors>Kenneth Napura</Authors>
		<PackageProjectUrl>https://github.com/kenjie-sama/TM.Common/tree/master/TM.Common.EntityFrameworkCore</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kenjie-sama/TM.Common</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\TM.Common.Constants\TM.Common.Constants.csproj" />
	</ItemGroup>

</Project>
